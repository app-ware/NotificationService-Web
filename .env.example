# HTTP port - only GET /health is served (docker healthcheck)
PORT=4448

# RabbitMQ - consumes push_queue and email_queue (see src/config/rabbitmq/rabbitmq.constants.ts)
# On the servers this is set by docker-compose.prod.yml from RABBITMQ_USER/RABBITMQ_PASS.
RABBITMQ_URL=amqp://user:pass@localhost:5672

# Push - legacy Firebase project + APN keys, each as base64-encoded JSON on one line.
# Generate both from the local keys/ folder: `npm run encode-credentials` (see keys/README.md).
FIREBASE_SERVICE_ACCOUNT_B64=
APN_CONFIG_B64=

# Email - Resend. MAIL_FROM must be on a domain verified in the SAME Resend account as the key;
# left blank it falls back to Resend's test sender (onboarding@resend.dev - account's own addresses only).
RESEND_API_KEY=
MAIL_FROM=

# Email layouts - all optional.
# Image URLs must be public HTTPS (email clients load them from the internet).
# iCare logo - unset → the portal's logo (https://icare-portal.com/en/assets/images/logos/LogoHQ.png).
MAIL_LOGO_URL=
# Store badges (assets/email/README.md) - both unset → text link buttons instead.
MAIL_APP_STORE_BADGE_URL=
MAIL_GOOGLE_PLAY_BADGE_URL=
# Link targets - unset → legacy iCare Kids store pages and https://icare-portal.com/en.
MAIL_APP_STORE_URL=
MAIL_PLAY_STORE_URL=
MAIL_PORTAL_URL=

# Internal HTTP - POST /mail/preview (Settings email preview, called by Nursery). Its own key,
# sent as X-Internal-API-Key; unset → the internal routes answer 503 (fail closed).
NOTIFICATION_SERVICE_API_KEY=
