# HTTP port - only GET /health is served (docker healthcheck)
PORT=4448

# RabbitMQ - consumes push_queue and email_queue (see src/config/rabbitmq/rabbitmq.constants.ts)
# In docker-compose: amqp://user:pass@rabbitmq:5672
RABBITMQ_URL=amqp://user:pass@localhost:5672

# Push - legacy Firebase project + APN keys, see keys/README.md
FIREBASE_SERVICE_ACCOUNT_PATH=keys/serviceAccountKey.json
APN_CONFIG_PATH=keys/apn.json

# Email - Resend. MAIL_FROM falls back to Resend's sandbox sender until a domain is verified.
RESEND_API_KEY=
MAIL_FROM=
